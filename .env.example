# Application Settings
DEBUG=False
ENVIRONMENT=development
APP_NAME=Deepshield
APP_VERSION=1.0.0

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars

# ── Database ───────────────────────────────────────────────────────────────────
# Option A: set DATABASE_URL directly (takes priority over all POSTGRES_* vars)
DATABASE_URL=postgresql://deepshield:changeme@localhost:5432/deepshield

# Option B: let the app build the URL from individual parts
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=deepshield
POSTGRES_USER=deepshield
POSTGRES_PASSWORD=changeme

# Connection pool (applied when using PostgreSQL)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DATABASE_ECHO=False

# Set to "true" to force SQLite regardless of other vars (local dev without Docker)
USE_SQLITE_RUNTIME=false

# API Configuration
API_HOST=0.0.0.0
API_PORT=5000
ENABLE_CORS=True
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=30

# Biometric Thresholds
FACE_RECOGNITION_THRESHOLD=0.6
VOICE_RECOGNITION_THRESHOLD=0.7
LIVENESS_CONFIDENCE_THRESHOLD=0.85
DEEPFAKE_DETECTION_THRESHOLD=0.8

# Rate Limiting
MAX_AUTHENTICATION_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
MAX_FAILED_ATTEMPTS_PER_DAY=10

# Risk Assessment
RISK_SCORE_THRESHOLD=70
BEHAVIORAL_BASELINE_SAMPLES=10
TYPING_SPEED_THRESHOLD=0.8
MOUSE_MOVEMENT_THRESHOLD=0.75
INTERACTION_PATTERN_THRESHOLD=0.8

# Liveness Detection
LIVENESS_VIDEO_DURATION_SECONDS=5
LIVENESS_FPS=30

# Deepfake Detection
DEEPFAKE_FRAME_SAMPLING_INTERVAL=5
DEEPFAKE_MIN_FRAMES=10

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_ENABLED=True
REDIS_CACHE_TTL_SECONDS=3600
REDIS_SESSION_TTL_HOURS=24

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/deepshield.log

# Compliance
DATA_RETENTION_DAYS=90
GDPR_COMPLIANT=True
ENCRYPTION_ALGORITHM=AES-256
BIOMETRIC_DATA_ENCRYPTION=True
AUDIT_LOGGING_ENABLED=True
